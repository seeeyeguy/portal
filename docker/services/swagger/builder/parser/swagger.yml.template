  /directory/resources:
    post:
      tags:
        - "directory.resource.create"
      summary: "Create a Resource."
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: "#/components/schemas/CreateResourceRequest"
            encoding:
              thumbnail:
                contentType: image/png, image/jpeg, image/jpg
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateResourceResponse"
        "400":
          description: "BAD REQUEST"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateResourceRevisionErroneousPreviousRevisionResponse"
                  - $ref: "#/components/schemas/CreateResourceWithDuplicatePendingDraftResponse"
                  - $ref: "#/components/schemas/CreateResourceDuplicateNameResponse"
                  - $ref: "#/components/schemas/CreateResourceInvalidDescriptionResponse"
                  - $ref: "#/components/schemas/CreateResourceMalformedURLResponse"
                  - $ref: "#/components/schemas/CreateResourceEmptyEmployeeLevelsResponse"
                  - $ref: "#/components/schemas/CreateResourceEmptySubFunctionsResponse"
                  - $ref: "#/components/schemas/CreateResourceEmptyPointOfContactsResponse"
                  - $ref: "#/components/schemas/CreateResourceInvalidThumbnailResponse"
                  - $ref: "#/components/schemas/CreateResourceUserInvalidRoleResponse"
        "401":
          description: "UNAUTHORIZED"
