    UpdateRequestRequest:
      title: "Update `Request` request." 
      type: object
      properties:
        resource_id: 
          type: integer
          description: Id for the `Resource` being updated.
          default: int
        name:
          type: string
          description: Name to be applied to the `Resource` being updated.
          default: "Update Resource Name"
        description:
          type: string
          description: Description to be applied to the `Resource` being updated.
          default: "Update Resource Description."
        url:
          type: string
          description: URL to be applied to the `Resource` being updated.
          default: https://www.example.com
        thumbnail:
          type: string
          description: Thumbnail image to be applied to the `Resource` being updated.
          format: binary
        employee_levels:
          type: array[int]
          description: Ids of `EmployeeLevel`s to be applied to the `Resource` being updated. Wrap array value in `"`.
          default: []
        subfunctions:
          type: array[int]
          description: Ids of `SubFunction`s to be applied to the `Resource` being updated. Wrap array value in `"`.
          default: []
        tags:
          type: array[int]
          description: Ids of `Tag`s to be applied to the `Resource` being updated. Wrap array value in `"`.
          default: []
        point_of_contacts:
          type: array[str]
          description: Emails for `User`s to create `PointOfContact`s that will be applied to the `Resource` being updated. Wrap array value in `"`.
          default: []
        type:
          type: string
          description: Type to be applied to the `Resource` being updated.
          default: "tableau"
        download:
          type: boolean
          description: Download flag to be applied to the `Resource` being updated.
          default: false
        stage:
          type: string
          description: Indicate whether to update the `Request` to the `DRAFT` or `SUBMITTED` stage.
          default: "DRAFT"


