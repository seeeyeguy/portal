          format: double
          nullable: true
          description: Cost Performance Index (CPI) cumulative.
        schedule_performance_index_cumulative:
          type: number
          format: double
          nullable: true
          description: Schedule Performance Index (SPI) cumulative.
        budget_at_complete:
          type: number
          format: double
          nullable: true
          description: Budget at Completion (BAC).
        estimate_at_complete:
          type: number
          format: double
          nullable: true
          description: Estimate at Completion (EAC).
        estimate_to_complete:
          type: number
          format: double
          nullable: true
          description: Estimate to Complete (ETC).
        management_reserve:
          type: number
          format: double
          nullable: true
          description: Management reserve amount.
        weighted_risks_and_opportunities:
          type: number
          format: double
          nullable: true
          description: Weighted risks & opportunities score.
        customer_assessment:
          type: integer
          nullable: true
          minimum: 1
          maximum: 4
          description: Subjective customer assessment rating (1‑4).
        technical_assessment:
          type: integer
          nullable: true
          minimum: 1
          maximum: 4
          description: Subjective technical assessment rating (1‑4).
        risk_assessment:
          type: integer
          nullable: true
          minimum: 1
          maximum: 4
          description: Subjective risk assessment rating (1‑4).
        overall_program:
          type: integer
          nullable: true
          minimum: 1
          maximum: 4
          description: Subjective overall program rating (1‑4).
        comments:
          type: string
          nullable: true
          description: Free‑form comments; maps to a Django `TextField`.
        is_manual_metrics_entry:
