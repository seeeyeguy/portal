                  - $ref: "#/components/schemas/CreateResourceSubFunctionDoesNotExistResponse"
                  - $ref: "#/components/schemas/CreateResourceTagDoesNotExistResponse"
                  - $ref: "#/components/schemas/CreateResourcePointOfContactDoesNotExistResponse"
    get:
      tags:
        - "directory.resource.fetch"
      summary: "Fetch Resource(s)."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Resource` record
            to fetch.
        - in: query
          name: page
          schema:
            type: integer
          description: Page number to select from a paginated response of
            `Resource` records to fetch.
        - in: query
          name: limit
          schema:
            type: integer
          description: Maximum number of `Resource` records to return.
      requestBody:
        content:
          application/json: {}
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchResourcesWithParametersResponse"
                  - $ref: "#/components/schemas/FetchResourceByIdResponse"
        "400":
          description: "Invalid parameters"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchResourcesInvalidParametersResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchResourcesUnauthorizedResponse"                 
        "404":
          description: "`Resource` does not exist for given id."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchResourceByIdDoesNotExistResponse"
    put:
      tags:
        - "directory.resource.update"
      summary: "Update a Resource."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Resource` record
            to update.
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: "#/components/schemas/UpdateResourceRequest"
            encoding:
              thumbnail:
                contentType: image/png, image/jpg, image/jpeg
      responses:
        "201":
          description: "UPDATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateResourceResponse"
        "400":
          description: "BAD REQUEST"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateResourceWithDuplicatePendingDraftResponse"
                  - $ref: "#/components/schemas/UpdateResourceApprovedResourceResponse"
                  - $ref: "#/components/schemas/UpdateResourceDuplicateNameResponse"
                  - $ref: "#/components/schemas/UpdateResourceInvalidDescriptionResponse"
                  - $ref: "#/components/schemas/UpdateResourceEmptyEmployeeLevelsResponse"
                  - $ref: "#/components/schemas/UpdateResourceEmptySubFunctionsResponse"
                  - $ref: "#/components/schemas/UpdateResourceEmptyPointOfContactsResponse"
                  - $ref: "#/components/schemas/UpdateResourceUnreachableURLResponse"
                  - $ref: "#/components/schemas/UpdateResourceUserInvalidRoleResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateResourceUnauthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateResourceForbiddenErrorResponse"
        "404":
          description: "Resource, EmployeeLevel, SubFunction, Tag or PointOfContact does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateResourceResourceDoesNotExistResponse"
                  - $ref: "#/components/schemas/UpdateResourceEmployeeLevelDoesNotExistResponse"
                  - $ref: "#/components/schemas/UpdateResourceSubFunctionDoesNotExistResponse"
                  - $ref: "#/components/schemas/UpdateResourceTagDoesNotExistResponse"
                  - $ref: "#/components/schemas/UpdateResourcePointOfContactDoesNotExistResponse"
  /directory/resources/search:
    post:
      tags:
        - "directory.resources.search"
      summary: "Search for Resources."
      parameters:
        - in: query
          name: page
          schema:
            type: integer
          description: Page number to select from a paginated response of
            `Resource` records.
        - in: query
          name: limit
          schema:
