openapi: 3.0.0
info:
  title: "{{APP_NAME}}"
  version: "1.0"
servers:
  - url: "{{SERVER_URL}}"
paths:
  /analytics/queries:
    post:
      tags:
        - "analytics.query.create"
      summary: "Create a Query."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateQueryRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateQueryResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateQueryUnauthorizedResponse"
  /analytics/visits:
    post:
      tags:
        - "analytics.visit.create"
      summary: "Create a Visit."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateVisitRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateVisitResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateVisitUnAuthorizedResponse"              
        "404":
          description: "Resource does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateVisitResourceDoesNotExistErrorResponse"
  /directory/employee-levels:
    get:
      tags:
        - "directory.employeelevel.fetch"
      summary: "Fetch EmployeeLevel(s)."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `EmployeeLevel` record
            to fetch.
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchEmployeeLevelsResponse"
                  - $ref: "#/components/schemas/FetchEmployeeLevelByIdResponse"                 
        "404":
          description: "Employee Level does not exist for given id."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchEmployeeLevelByIdDoesNotExistResponse"
    put:
      tags:
        - "directory.employeelevel.update"
      summary: "Update an EmployeeLevel."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `EmployeeLevel` record
            to update.
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateEmployeeLevelRequest"
      responses:
        "201":
          description: "UPDATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateEmployeeLevelResponse"
        "400":
          description: "EmployeeLevel name is a duplicate."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateEmployeeLevelDuplicateNameErrorResponse" 
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateEmployeeLevelUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateEmployeeLevelForbiddenErrorResponse"
        "404":
          description: "EmployeeLevel does not exist for given id."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateEmployeeLevelByIdDoesNotExistErrorResponse" 
    delete:
      tags:
        - "directory.employeelevel.delete"
      summary: "Delete EmployeeLevel."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `EmployeeLevel` record
            to delete.
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteEmployeeLevelResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteEmployeeLevelUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteEmployeeLevelForbiddenErrorResponse"
  /directory/functions:
    post:
      tags:
        - "directory.function.create"
      summary: "Create Function."
      requestBody:
          content:
            application/json: 
              schema:
                $ref: "#/components/schemas/CreateFunctionRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFunctionResponse"
        "400":
          description: "Function name is a duplicate."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFunctionDuplicateNameErrorResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFunctionUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFunctionForbiddenErrorResponse"
    get:
      tags:
        - "directory.function.fetch"
      summary: "Fetch Function(s)."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Function` record
            to fetch.
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFunctionsResponse"
                  - $ref: "#/components/schemas/FetchFunctionByIdResponse"                 
        "404":
          description: "Function does not exist for given id."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFunctionByIdDoesNotExistResponse"
    put:
      tags:
        - "directory.function.update"
      summary: "Update a Function."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Function` record
            to update.
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateFunctionRequest"
      responses:
        "201":
          description: "UPDATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateFunctionResponse"
        "400":
          description: "Function name is a duplicate."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateFunctionDuplicateNameResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateFunctionUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateFunctionForbiddenErrorResponse"
        "404":
          description: "Function does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateFunctionDoesNotExistResponse"
    delete:
      tags:
        - "directory.function.delete"
      summary: "Delete Function."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Function` record
            to be deleted.
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteFunctionResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteFunctionUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteFunctionForbiddenErrorResponse"
  /directory/resources/search:
    post:
      tags:
        - "directory.resources.search"
      summary: "Search for Resources."
      parameters:
        - in: query
          name: page
          schema:
            type: integer
          description: Page number to select from a paginated response of
            `Resource` records.
        - in: query
          name: limit
          schema:
            type: integer
          description: Maximum number of `Resource` records to return.        
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ResourceSearchRequest"
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/ResourceSearchFunctreeStructureSerializedResponse"
                  - $ref: "#/components/schemas/ResourceSearchDefaultStructureResponse"                 
        "400":
          description: "Missing parameter or invalid parameter."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/ResourceSearchMissingParameterErrorResponse"
                  - $ref: "#/components/schemas/ResourceSearchInvalidParameterErrorResponse"
  /directory/subfunctions:
    get:
      tags:
        - "directory.subfunction.fetch"
      summary: "Fetch SubFunction(s)."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `SubFunction` record
            to fetch.
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchSubFunctionsResponse"
                  - $ref: "#/components/schemas/FetchSubFunctionByIdResponse"                 
        "404":
          description: "SubFunction does not exist for given id."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchSubFunctionByIdDoesNotExistResponse"
    delete:
      tags:
        - "directory.subfunction.delete"
      summary: "Delete SubFunction."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `SubFunction` record
            to be deleted.
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteSubFunctionResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteSubFunctionUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteSubFunctionForbiddenErrorResponse"
  /directory/tags:
    get:
      tags:
        - "directory.tag.fetch"
      summary: "Fetch Tag(s)."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Tag` record
            to fetch.
        - in: query
          name: page
          schema:
            type: integer
          description: Page number to select from a paginated response of
            `Tag` records.
        - in: query
          name: limit
          schema:
            type: integer
          description: Maximum number of `Tag` records to return.
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchTagsResponse"
                  - $ref: "#/components/schemas/FetchTagByIdResponse"
        "400":
          description: "Invalid parameters."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchTagsInvalidParametersErrorResponse"
        "404":
          description: "Tag does not exist for given id."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchTagByIdDoesNotExistResponse"     
  /directory/tags/search:
    get:
      tags:
        - "directory.tag.search"
      summary: "Search for Tags based on the given label."
      parameters:
        - in: query
          name: label
          schema:
            type: string
          description: "Label that will be used to search for Tags."
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/SearchTagsResponse"
  /preferences/favorites:
    post:
      tags:
        - "preferences.favorite.create"
      summary: "Create a Favorite."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateFavoriteRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFavoriteResponse"
        "400":
          description: "BAD REQUEST"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFavoriteBadRequestResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFavoriteUnAuthorizedResponse"              
        "404":
          description: "User or Resource does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateFavoriteUserDoesNotExistResponse"
                  - $ref: "#/components/schemas/CreateFavoriteResourceDoesNotExistResponse"
    get:
      tags:
        - "preferences.favorite.fetch"
      summary: "Fetch a user's Favorites based on the given email."
      parameters:
        - in: query
          name: user
          schema:
            type: string
          description: "User's email related to the desired `Favorite`s."
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFavoritesResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFavoriteUnAuthorizedResponse"
        "404":
          description: "User does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFavoritesUserDoesNotExistResponse"
    put:
      tags:
        - "preferences.favorite.rank"
      summary: "Update the ranks for a user's Favorites based on the given email
        and supplied rankings."
      parameters:
        - in: query
          name: user
          schema:
            type: string
          description: "User's email related to the `Favorite`s that will be
            updated."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/RankFavoritesRequest"
      responses:
        "201":
          description: "UPDATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/RankFavoritesResponse"
        "400":
          description: "BAD REQUEST"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/RankFavoritesInvalidParametersResponse"                  
                  - $ref: "#/components/schemas/RankFavoritesInvalidRanksResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/RankFavoritesUnAuthorizedResponse"
        "404":
          description: "User does not exist or missing user Favorite ids."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/RankFavoritesUserDoesNotExistResponse"
                  - $ref: "#/components/schemas/RankFavoritesMissingUserFavoritesResponse"
    delete:
      tags:
        - "preferences.favorite.delete"
      summary: "Delete an existing Favorite by the given id."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: "Primary key of the `Favorite` record to be deleted."
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteFavoriteResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteFavoriteUnAuthorizedResponse"

  /preferences/query-filter-state:
    post:
      tags:
        - "preferences.queryfilterstate.create"
      summary: "Create a QueryFilterState."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateQueryFilterStateRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateQueryFilterStateResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateQueryFilterStateUnAuthorizedResponse"              
        "404":
          description: "Query, Function, EmployeeLevel, or Tag does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateQueryFilterStateQueryDoesNotExistErrorResponse"
                  - $ref: "#/components/schemas/CreateQueryFilterStateFunctionDoesNotExistErrorResponse"
                  - $ref: "#/components/schemas/CreateQueryFilterStateEmployeeLevelDoesNotExistErrorResponse"
                  - $ref: "#/components/schemas/CreateQueryFilterStateTagDoesNotExistErrorResponse"
    get:
      tags:
        - "preferences.queryfilterstate.fetch"
      summary: "Fetch a user's QueryFilterState based on the given email."
      parameters:
        - in: query
          name: user
          schema:
            type: string
          description: "User's email related to the desired `QueryFilterState`."
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchQueryFilterStateResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchQueryFilterStateUnAuthorizedResponse"
        "404":
          description: "User, or QueryFilterState does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchQueryFilterStateUserDoesNotExistResponse"
                  - $ref: "#/components/schemas/FetchQueryFilterStateQueryFilterStateForUserDoesNotExistResponse"
    put:
      tags:
        - "preferences.queryfilterstate.update"
      summary: "Update a QueryFilterState."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `QueryFilterState` record
            to update.
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateQueryFilterStateRequest"
      responses:
        "201":
          description: "UPDATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateQueryFilterStateResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateQueryFilterStateUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateQueryFilterStateForbiddenErrorResponse"
        "404":
          description: "QueryFilterState, Query, Function, EmployeeLevel, or Tag does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/UpdateQueryFilterStateQueryFilterStateDoesNotExistErrorResponse"
                  - $ref: "#/components/schemas/UpdateQueryFilterStateQueryDoesNotExistErrorResponse"
                  - $ref: "#/components/schemas/UpdateQueryFilterStateFunctionDoesNotExistErrorResponse"
                  - $ref: "#/components/schemas/UpdateQueryFilterStateEmployeeLevelDoesNotExistErrorResponse"
                  - $ref: "#/components/schemas/UpdateQueryFilterStateTagDoesNotExistErrorResponse"  
  /users/profile:
    get:
      tags:
        - "users.profile.fetch"
      summary: "Fetch a user's Profile based on the given email."
      parameters:
        - in: query
          name: user
          schema:
            type: string
          description: "User's email related the desired profile."
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchProfileResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchProfileUnAuthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchProfilePermissionsDeniedResponse"   


