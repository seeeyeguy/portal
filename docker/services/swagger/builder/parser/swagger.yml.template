openapi: 3.0.0
info:
  title: "{{APP_NAME}}"
  version: "1.0"
servers:
  - url: "{{SERVER_URL}}"
paths:
  /analytics/queries:
    post:
      tags:
        - "analytics.query.create"
      summary: "Create a Query."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateQueryRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateQueryResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateQueryUnauthorizedResponse"
    get:
      tags:
        - "analytics.query.fetch"
      summary: "Fetch Query."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Query` record
            to fetch.
        - in: query
          name: resource_id
          schema:
            type: integer
          description: Primary key of the `Resource` record
            to filter by.
        - in: query
          name: user
          schema:
            type: string
          description: "User's email related to the desired `Query` records."
        - in: query
          name: page
          schema:
            type: integer
          description: Page number to select from a paginated response of
            `Query` records.
        - in: query
          name: limit
          schema:
            type: integer
          description: Maximum number of `Query` records to return.
        - in: query
          name: search_term
          schema:
            type: string
            maxLength: 512
          description: A search term used when searching for resources.
      requestBody:
        content:
          application/json: {}
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchQueryWithParametersResponse"
                  - $ref: "#/components/schemas/FetchQueryByIdResponse"
        "400":
          description: "Invalid parameters"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchQueryInvalidParametersResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchQueryUnauthorizedResponse"
        "404":
          description: "`Query`, `Resource`, or `User` does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchQueryByIdDoesNotExistResponse"
                  - $ref: "#/components/schemas/FetchQueryByResourceIdDoesNotExistResponse"
                  - $ref: "#/components/schemas/FetchQueryUserDoesNotExistResponse"
  /analytics/visits:
    post:
      tags:
        - "analytics.visit.create"
      summary: "Create a Visit."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateVisitRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateVisitResponse"
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateVisitUnauthorizedResponse"              
        "404":
          description: "Resource does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateVisitResourceDoesNotExistErrorResponse"
    get:
      tags:
        - "analytics.visit.fetch"
      summary: "Fetch most visited resources."
      description: |
        Retrieve aggregated `Visit` data showing the most visited resources. 
        Supports filtering by user email, resource ID, and pagination. 
        Results are ordered by visit count descending.
      parameters:
        - in: query
          name: user
          schema:
            type: string
          description: Email address (stored as username) of the `User` whose visits should be considered.
        - in: query
          name: resource
          schema:
            type: integer
          description: Primary key of the `Resource` record to filter visits by.
        - in: query
          name: page
          schema:
            type: integer
            minimum: 1
          description: Page number to select from a paginated response of aggregated resource visits.
        - in: query
          name: limit
          schema:
            type: integer
            minimum: 1
          description: Maximum number of aggregated resource results to return per page.
        - in: query
          name: top
          schema:
            type: integer
            minimum: 1
          description: Return only the top N most visited resources (alternative to pagination).
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchVisitResponse"
        "400":
          description: "Invalid parameters (e.g. mixing 'top' with 'page/limit' or invalid resource id)."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchVisitTopwithLimitandPageResponse"
                  - $ref: "#/components/schemas/FetchVisitInvalidParametersResponse"
        "404":
          description: "User or Resource not found."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchVisitNotFoundResponse"
  /analytics/favorites:
    get:
      tags:
        - "analytics.favorite.fetch"
      summary: "Fetch favorited resources."
      parameters:
        - in: query
          name: user
          schema:
            type: string
          description: "Email address (stored as username) of the User whose favorites should be filtered."
        - in: query
          name: page
          schema:
            type: integer
            minimum: 1
          description: Page number to select from a paginated response of favorited resources. Must be used with `limit`.
        - in: query
          name: limit
          schema:
            type: integer
            minimum: 1
          description: Maximum number of favorited resources to return. Must be used with `page`.
        - in: query
          name: top
          schema:
            type: integer
            minimum: 1
          description: Return only the top N favorited resources (ordered by popularity). Cannot be used with `page` or `limit`.
      responses:
        "200":
          description: "OK. Returns favorited resources or an empty array if user exists but has no favorites."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFavoriteResponse"
                  - type: array
                    items: {}
        "400":
          description: "Invalid parameters"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFavoriteTopwithLimitandPageResponse"
                  - $ref: "#/components/schemas/FetchFavoriteInvalidParametersResponse"
        "404":
          description: "User does not exist or resource not favorited."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchFavoriteNotFoundResponse"
  /analytics/prt/usage:
    get:
      tags:
        - "analytics.usage.fetch"
      summary: "Fetch Usage record(s)."
      parameters:
        - in: query
          name: id
          schema:
            type: integer
          description: Primary key of the `Usage` record to fetch.
        - in: query
          name: user
          schema:
            type: string
          description: "User's email related to the desired `Usage` records."
        - in: query
          name: page
          schema:
            type: integer
          description: Page number to select from a paginated response of `Usage` records.
        - in: query
          name: limit
          schema:
            type: integer
          description: Maximum number of `Usage` records to return.
        - in: query
          name: pa_number
          schema:
            type: string
          description: "Program PA number to filter `Usage` records."
        - in: query
          name: success
          schema:
            type: boolean
          description: "Filter `Usage` records by success flag (true or false)."
      requestBody:
        content:
          application/json: {}         
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchUsageResponse"
        "400":
          description: "Invalid parameters"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FetchUsageInvalidParametersResponse"          
        "404":
          description: "Usage does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchUsageNotFoundResponse"
  /content/content:
    post:
      tags:
        - "content.content.create"
      summary: "Create a Content record."
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateContentRequest"
      responses:
        "201":
          description: "CREATED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateContentResponse"
        "400":
          description: "Key is not unique or Content not JSON compliant."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateContentErrorResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/CreateContentForbiddenErrorResponse"
    get:
      tags:
        - "content.content.fetch"
      summary: "Fetch Content."
      parameters:
        - in: query
          name: key
          schema:
            type: string
          description: Alias for `Content` record to fetch.
      requestBody:
        content:
          application/json: {}
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchContentWithParametersResponse"
        "404":
          description: "`Content` does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/FetchContentByKeyDoesNotExistResponse"
    delete:
      tags:
        - "content.content.delete"
      summary: "Delete a `Content` record."
      parameters:
        - in: query
          name: key
          schema:
            type: string
          description: Key for the desired 'Content'.
      requestBody:
        content:
          application/json: {}
      responses:
        "200":
          description: "OK"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteContentResponse"
        "400":
          description: "BAD REQUEST"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteContentInvalidParamsResponse"      
        "401":
          description: "UNAUTHORIZED"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteContentUnauthorizedResponse"
        "403":
          description: "FORBIDDEN"
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteContentForbiddenErrorResponse"
        "404":
          description: "Content does not exist."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/DeleteContentDoesNotExistResponse"   
