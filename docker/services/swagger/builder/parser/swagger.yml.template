    CreateRecordRequest:
      title: "Create a Record for a specific program and reporting period."
      type: object
      required:
        - pa_number
        - reporting_period
      properties:
        pa_number:
          type: string
          maxLength: 1028
          description: Program‑PA identifier.
        reporting_period:
          type: integer
          description: Reporting period (e.g., fiscal quarter or year).
        name:
          type: string
          maxLength: 1028
          nullable: true
          description: Optional name for the Record.
        segment:
          type: string
          maxLength: 1028
          nullable: true
          description: Business segment.
        sector:
          type: string
          maxLength: 1028
          nullable: true
          description: Sector classification.
        division:
          type: string
          maxLength: 1028
          nullable: true
          description: Division within the organization.
        tier:
          type: integer
          nullable: true
          minimum: 1
          maximum: 4
          description: Tier level (1‑4).
        program_phase:
          type: string
          maxLength: 1028
          nullable: true
          description: Phase of the program.
        site:
          type: string
          maxLength: 1028
          nullable: true
          description: Site location.
        defense_financial_acquisition_regulation_clause:
          type: boolean
          nullable: true
          description: Indicator for DFAR clause applicability.
        cost_and_software_data_reporting_system_clause:
          type: boolean
          nullable: true
          description: Indicator for CSRS clause applicability.
        earned_value_management_system_reporting_requirement:
          type: string
          maxLength: 1028
          nullable: true
          description: Earned‑value‑management reporting requirement.
        contract_type:
          type: string
          maxLength: 1028
          nullable: true
          description: Type of contract.
        contract_number:
          type: string
          maxLength: 1028
          nullable: true
          description: Contract identification number.
        contract_value:
          type: integer
          nullable: true
          description: Monetary value of the contract.
        contract_start_date:
          type: string
          format: date
          nullable: true
          description: Contract start date.
        contract_end_date:
          type: string
          format: date
          nullable: true
          description: Contract end date.
        actual_cost_work_performed_cumulative:
