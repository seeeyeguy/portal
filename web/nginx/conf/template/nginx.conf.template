upstream api {
    server api:8080;
}

server {
        listen 443 ssl;

        # set file size limit for POST requests to 5MB
        client_max_body_size 5M;

        # where is the root
        root /var/www;
        # what file to serve as index
        index index.html index.htm;
        
        # This is the Docker built-in DNS
        resolver 127.0.0.11 ipv6=off;

        # Setting timeout to process large operation
        # to avoid gateway timeout error before we optimize our baseline
        proxy_connect_timeout       ${TIMEOUT_SECONDS};
        proxy_send_timeout          ${TIMEOUT_SECONDS};
        proxy_read_timeout          ${TIMEOUT_SECONDS};
        send_timeout                ${TIMEOUT_SECONDS};

        ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
        ssl_certificate /etc/nginx/ssl/${SSL_CERT};
        ssl_certificate_key /etc/nginx/ssl/${SSL_KEY};
        ssl_password_file  /etc/nginx/ssl/${SSL_PASS};

        error_page 497 301 =307 https://$host:${WDS_SOCKET_PORT}$request_uri;

        location ~* ^(/api)?/v1/(svc|static|media)/([\S\s]+)$ {
            rewrite ^/api(.*)$ $1 break;
            proxy_pass http://api;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Host $host;
            proxy_redirect off;
        }

        location / {
            # First attempt to serve request as file, then
            # as directory, then fall back to redirecting to index.html
            try_files $uri $uri/ /index.html;
        }

        # Media: images, icons, video, audio, HTC
        location ~* \.(?:jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc)$ {
          expires 1M;
          access_log off;
          add_header Cache-Control "public";
        }

        # Javascript and CSS files
        location ~* \.(?:css|js)$ {
            try_files $uri =404;
            expires 1y;
            access_log off;
            add_header Cache-Control "public";
        }

        # Any route containing a file extension (e.g. /devicesfile.js)
        location ~ ^.+\..+$ {
            try_files $uri =404;
        }
}